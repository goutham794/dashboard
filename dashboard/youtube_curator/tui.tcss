Screen {
    background: #101416;
    color: #eef3ef;
}

Header {
    background: #19342f;
    color: #f2f8f4;
}

Footer {
    background: #151b1f;
    color: #c5d0ca;
}

#layout {
    height: 1fr;
}

#sidebar {
    width: 44%;
    min-width: 38;
    max-width: 74;
    border-right: solid #31403b;
    background: #141a1d;
}

#summary {
    height: auto;
    padding: 1 2;
    border-bottom: solid #31403b;
    color: #dce9e2;
}

#items {
    height: 1fr;
    background: #141a1d;
}

DashboardListItem {
    padding: 1 2;
}

DashboardListItem.--highlight {
    background: #244d43;
    color: #ffffff;
}

#detail-pane {
    width: 1fr;
    padding: 1 3;
    background: #101416;
}

#detail {
    width: 1fr;
    color: #edf5f1;
}
